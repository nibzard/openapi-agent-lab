{
  "openapi": "3.1.0",
  "info": {
    "title": "Nullable 3.0",
    "version": "1.0.0"
  },
  "paths": {
    "/items": {
      "get": {
        "operationId": "listItems",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": { "type": ["string", "null"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ItemPage" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ItemPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Item" }
          }
        }
      },
      "Item": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "label": { "type": ["string", "null"] },
          "score": { "type": "number", "exclusiveMinimum": 0 },
          "releasedAt": { "type": ["string", "null"] }
        }
      }
    }
  }
}
