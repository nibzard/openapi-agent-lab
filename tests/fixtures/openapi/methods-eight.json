{
  "openapi": "3.1.0",
  "info": {
    "title": "Eight-method resource API",
    "version": "1.0.0"
  },
  "paths": {
    "/resource": {
      "get": {
        "operationId": "listResources",
        "summary": "List resources in two representations",
        "responses": {
          "200": {
            "description": "A page of resources",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResourcePage" }
              },
              "text/plain": {
                "schema": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createResource",
        "summary": "Create one resource",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewResource" },
              "examples": {
                "first": { "value": { "name": "first-resource" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created resource",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resource" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replaceResources",
        "deprecated": true,
        "responses": {
          "200": {
            "description": "Replaced",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResourcePage" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete every resource without an operationId",
        "responses": {
          "204": { "description": "Deleted" }
        }
      },
      "options": {
        "operationId": "optionsResource",
        "responses": {
          "204": { "description": "Options acknowledged" }
        }
      },
      "head": {
        "operationId": "headResource",
        "responses": {
          "200": {
            "description": "The same representation as GET",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResourcePage" }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchResource",
        "responses": {
          "200": {
            "description": "Patched",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resource" }
              }
            }
          }
        }
      },
      "trace": {
        "operationId": "traceResource",
        "responses": {
          "200": {
            "description": "The trace text",
            "content": {
              "text/plain": {
                "schema": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Resource": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      },
      "NewResource": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "labels": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ResourcePage": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/components/schemas/Resource" }
      }
    }
  }
}
