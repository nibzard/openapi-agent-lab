{
  "$schema": "https://agentlab.dev/schemas/contract-ir.v1.json",
  "api": {
    "description": "webclip captures a live web page as a clip, renders it, extracts its text, and exports the capture. A new clip starts in the pending status. Rendering moves it to rendered or failed. Extraction works only on a rendered clip and moves it to extracted. The content endpoint serves the captured representation, guided by the clip's format and the Accept header. Every request needs a bearer token.",
    "servers": [
      {
        "description": "Public endpoint. The lab serves a local mock instead.",
        "url": "https://api.webclip.example.com",
        "variables": {}
      }
    ],
