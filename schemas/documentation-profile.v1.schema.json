{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.dev/schemas/documentation-profile.v1.json",
  "title": "DocumentationProfile",
  "description": "Frozen documentation-facade behavior: GET-only candidates, roles, authentication, ordering, and ceilings. Encodes SPEC section 15.11.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "candidates",
    "authentication",
    "content_type",
    "headers",
    "index_link_ordering",
    "disabled_candidate_outcome",
    "max_bytes",
    "response_profile",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "DocumentationProfile"
    },
    "id": {
      "$ref": "#/$defs/safeId"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "method", "path", "role", "enabled"],
        "properties": {
          "route_id": {
            "$ref": "#/$defs/safeId"
          },
          "method": {
            "const": "GET"
          },
          "path": {
            "type": "string",
            "pattern": "^/[^{}]*$"
          },
          "role": {
            "type": "string",
            "enum": ["contract", "index"]
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "authentication": {
      "type": "string",
      "enum": ["none", "required"]
    },
    "content_type": {
      "type": "string",
      "minLength": 1
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "index_link_ordering": {
      "type": "string",
      "enum": ["canonical", "declared"]
    },
    "disabled_candidate_outcome": {
      "type": "string",
      "enum": ["neutral_unknown_route"]
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "response_profile": {
      "$ref": "#/$defs/safeId"
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    }
  }
}
