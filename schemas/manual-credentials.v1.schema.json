{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.dev/schemas/manual-credentials.v1.json",
  "title": "ManualCredentials",
  "description": "Private control-plane file of synthetic credential values for a manual serve run. Never evidence; deleted at finalization. Encodes SPEC section 23.4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "base_url", "alternatives"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "base_url": {
      "type": "string",
      "pattern": "^https?://[^/]+$"
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "schemes"],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "schemes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scheme",
                "type",
                "location",
                "wire_name",
                "environment"
              ],
              "properties": {
                "scheme": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "apiKey",
                    "http",
                    "oauth2",
                    "openIdConnect",
                    "mutualTLS"
                  ]
                },
                "location": {
                  "type": ["string", "null"],
                  "enum": [null, "query", "header", "cookie"]
                },
                "wire_name": {
                  "type": ["string", "null"]
                },
                "environment": {
                  "type": "string",
                  "pattern": "^[A-Z_][A-Z0-9_]*$",
                  "minLength": 1
                },
                "value": {
                  "type": ["string", "null"],
                  "description": "Synthetic secret. Basic alternatives use username and password instead."
                },
                "username": {
                  "type": ["string", "null"]
                },
                "password": {
                  "type": ["string", "null"]
                },
                "token": {
                  "type": ["string", "null"]
                }
              },
              "oneOf": [
                {
                  "required": ["value"]
                },
                {
                  "required": ["username", "password"]
                },
                {
                  "required": ["token"]
                }
              ]
            }
          }
        }
      }
    }
  }
}
