{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.dev/schemas/pack-ref.v1.json",
  "title": "PackRef",
  "description": "Immutable reference to a pack by identity, version, and digest. Location is deliberately absent. Encodes SPEC sections 12.8 and 12.10.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "sha256"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
