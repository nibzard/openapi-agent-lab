{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.dev/schemas/source-provenance.v1.json",
  "title": "SourceProvenance",
  "description": "Frozen implementation and release provenance: git or content-addressed release state, component versions, runtime, and dependency lock. Encodes SPEC section 24.5.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "release",
    "components",
    "node_version",
    "os",
    "arch",
    "dependency_lock_sha256",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "SourceProvenance"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "content-addressed-release",
            "clean-worktree",
            "dirty-override"
          ]
        },
        "commit": {
          "$ref": "#/$defs/sha256OrNull"
        },
        "tag": {
          "type": ["string", "null"]
        },
        "status": {
          "type": ["string", "null"]
        },
        "diff_sha256": {
          "$ref": "#/$defs/sha256OrNull"
        },
        "source_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "version"],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "feature_probe_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "node_version": {
      "type": "string",
      "minLength": 1
    },
    "os": {
      "type": "string",
      "minLength": 1
    },
    "arch": {
      "type": "string",
      "minLength": 1
    },
    "dependency_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "environment_names": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256OrNull": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
