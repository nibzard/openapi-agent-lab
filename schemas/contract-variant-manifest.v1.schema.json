{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.dev/schemas/contract-variant-manifest.v1.json",
  "title": "ContractVariantManifest",
  "description": "One materialized ContractVariant with its compiled effective contract and verified inventories. Encodes SPEC sections 12.12 and 24.2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "variant_id",
    "set_id",
    "base_sha256",
    "transform_sha256",
    "effective",
    "capability_report_sha256",
    "behavior_adapters",
    "diff_path",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "ContractVariantManifest"
    },
    "variant_id": {
      "$ref": "#/$defs/safeId"
    },
    "set_id": {
      "$ref": "#/$defs/safeId"
    },
    "base_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "common_projection_sha256": {
      "$ref": "#/$defs/sha256OrNull"
    },
    "transform_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "effective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openapi_sha256",
        "semantic_sha256",
        "execution_sha256",
        "operation_count"
      ],
      "properties": {
        "openapi_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "operation_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "capability_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "behavior_adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "adapter_id", "adapter_sha256"],
        "properties": {
          "operation": {
            "type": "string",
            "pattern": "^path:[A-Z]+ [^ ]+$"
          },
          "adapter_id": {
            "$ref": "#/$defs/safeId"
          },
          "adapter_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "diff_path": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256OrNull": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
