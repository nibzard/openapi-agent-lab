{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.dev/schemas/assignment-schedule.v1.json",
  "title": "AssignmentSchedule",
  "description": "Immutable assignments.json generated before any server or participant starts. Prospective assignment kind/status only; activation facts live in assignment events. Encodes SPEC section 12.11.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "study_run_id",
    "phase_id",
    "algorithm",
    "schedule_seed",
    "assignments"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "AssignmentSchedule"
    },
    "study_run_id": {
      "$ref": "#/$defs/safeId"
    },
    "phase_id": {
      "$ref": "#/$defs/safeId"
    },
    "algorithm": {
      "type": "string",
      "enum": ["canonical-sha256-sort-v1"]
    },
    "schedule_seed": {
      "type": "string",
      "minLength": 1
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignment_id",
          "kind",
          "status",
          "study_run_id",
          "phase_id",
          "cell_id",
          "child_batch_id",
          "slot",
          "factor_levels",
          "factor_level_digests",
          "sort_key"
        ],
        "properties": {
          "assignment_id": {
            "$ref": "#/$defs/controlId"
          },
          "kind": {
            "type": "string",
            "enum": ["primary", "held_replacement"]
          },
          "status": {
            "type": "string",
            "enum": ["planned", "held"]
          },
          "study_run_id": {
            "$ref": "#/$defs/safeId"
          },
          "phase_id": {
            "$ref": "#/$defs/safeId"
          },
          "cell_id": {
            "$ref": "#/$defs/safeId"
          },
          "child_batch_id": {
            "$ref": "#/$defs/controlId"
          },
          "slot": {
            "type": "integer",
            "minimum": 0
          },
          "block_id": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "repetition_index": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "reserve_index": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "eligible_stratum_policy": {
            "type": ["string", "null"]
          },
          "factor_levels": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/safeId"
            },
            "propertyNames": {
              "$ref": "#/$defs/safeId"
            }
          },
          "factor_level_digests": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/sha256"
            },
            "propertyNames": {
              "$ref": "#/$defs/safeId"
            }
          },
          "contract_variant_sha256": {
            "$ref": "#/$defs/sha256OrNull"
          },
          "participant_surface_policy_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "eval_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "scenario_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "rubric_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "run_profile_template_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "sort_key": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "controlId": {
      "type": "string",
      "description": "Domain-separated control ID: prefix plus 24 to 32 lowercase hexadecimal characters of SHA-256.",
      "pattern": "^(asg|bat|run)_[a-f0-9]{24,32}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256OrNull": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
