{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.dev/schemas/participant-surface-verification.v1.json",
  "title": "ParticipantSurfaceVerification",
  "description": "Post-run comparison of the archived workspace and captured participant channels against the frozen surface manifest. Names every discovered entry and mismatch. Encodes SPEC sections 9.6 and 24.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "manifest_sha256",
    "verified",
    "discovered",
    "mismatches",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "ParticipantSurfaceVerification"
    },
    "run_id": {
      "$ref": "#/$defs/safeId"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "verified": {
      "type": "boolean"
    },
    "discovered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "channel", "status"],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "type": "string",
            "enum": [
              "file",
              "http-route",
              "environment",
              "credential",
              "tool",
              "message",
              "workspace"
            ]
          },
          "matched_entry": {
            "$ref": "#/$defs/safeIdOrNull"
          },
          "status": {
            "type": "string",
            "enum": ["declared", "undeclared", "missing"]
          }
        }
      }
    },
    "mismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "kind"],
        "properties": {
          "entry_id": {
            "$ref": "#/$defs/safeId"
          },
          "kind": {
            "type": "string",
            "enum": ["hash", "size", "media_type", "name", "undeclared"]
          },
          "expected": {
            "description": "Value expected by the manifest entry."
          },
          "actual": {
            "description": "Value observed after execution."
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "safeIdOrNull": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
