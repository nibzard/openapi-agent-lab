{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.dev/packs/steel-computer/schemas/checkpoint-recovery-case.schema.json",
  "title": "Steel Computer checkpoint-recovery case input",
  "description": "Synthetic non-secret inputs of one checkpoint-recovery case line. Template variables read them as case.input.<key>.",
  "type": "object",
  "properties": {
    "seed_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "replacement_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": ["seed_path", "replacement_path"],
  "additionalProperties": false
}
