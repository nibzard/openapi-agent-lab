{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.dev/packs/steel-computer/schemas/checkpoint-recovery-case.schema.json",
  "title": "Steel Computer checkpoint-recovery case",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 64
    },
    "input": {
      "type": "object",
      "properties": {
        "seed_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "replacement_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["seed_path", "replacement_path"],
      "additionalProperties": false
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": ["id", "input"],
  "additionalProperties": false
}
