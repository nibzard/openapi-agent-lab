{
  "name": "openapi-agent-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic OpenAPI mock, agent test harness, and evaluation system.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "boundaries": "node scripts/check-package-boundaries.mjs",
    "build": "pnpm run typecheck",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run boundaries && pnpm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "probe:compile": "node scripts/perf-probe.mjs",
    "probe:schedule": "node scripts/schedule-balance.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "readiness": "node scripts/release-readiness.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vitest": "4.0.8"
  }
}
